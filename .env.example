# ==============================================================================
# GLOWISTIC (.env.example)
# ==============================================================================
# 1. Copy this file and save it as ".env" in your project root:
#      cp .env.example .env
# 2. Fill in your real Meta Business credentials inside ".env".
# 3. NEVER commit the ".env" file to GitHub (it is excluded in .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# WHATSAPP CLOUD API (META BUSINESS) ORDER NOTIFICATIONS
# ------------------------------------------------------------------------------
# In Meta Developer Dashboard (https://developers.facebook.com):
# App -> WhatsApp -> API Setup:
# - Copy "Phone number ID" -> WHATSAPP_PHONE_NUMBER_ID
# - Generate or copy Access Token -> WHATSAPP_ACCESS_TOKEN
# - Receiver phone number for order alerts (Format: 923136895852)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ORDER_ALERT_NUMBER=923136895852
WHATSAPP_API_VERSION=v20.0

# ------------------------------------------------------------------------------
# RESEND ORDER EMAIL NOTIFICATIONS (https://resend.com)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here
ORDER_EMAIL_TO=Glowisticpk@gmail.com
ORDER_EMAIL_FROM=Glowistic Orders <onboarding@resend.dev>

